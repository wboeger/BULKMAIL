# Copy this file to .env and fill in your real values.
# NEVER commit your real .env file (it's already in .gitignore).

# --- SMTP connection ---
# UFPR institutional email (Microsoft 365): smtp.office365.com, port 587, STARTTLS
# Gmail / Google Workspace                : smtp.gmail.com,      port 587, STARTTLS
# Other providers                         : check your provider's SMTP docs
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_SSL=false

# --- Your professional mailbox credentials ---
# UFPR / Microsoft 365: username is your full @ufpr.br address, authentication
# is your normal mailbox password (unless your account requires an app
# password / MFA app password - check with UFPR's IT/NTI if login fails).
SMTP_USER=seunome@ufpr.br
SMTP_PASSWORD=sua-senha

# --- Microsoft 365 OAuth2 (alternative to SMTP_PASSWORD, e.g. when the
#     tenant disabled basic auth / SMTP with plain username+password) ---
# SMTP_AUTH_METHOD=oauth2
# Application (client) ID of a public-client app you register in Entra ID /
# Azure AD (no client secret needed). See README.md for the exact steps.
# MS_OAUTH_CLIENT_ID=
# MS_OAUTH_TENANT_ID=organizations
# After setting these, run: python3 oauth_setup.py (one-time interactive login)
# SMTP_PASSWORD can be left unset when SMTP_AUTH_METHOD=oauth2.

# --- Sender identity shown to recipients ---
FROM_NAME=Seu Nome
FROM_EMAIL=seunome@ufpr.br
REPLY_TO=seunome@ufpr.br

# --- Sending behaviour ---
# Seconds to wait between messages (avoids provider rate limits / spam flags)
SEND_DELAY_SECONDS=2
# Seconds to back off after the server signals throttling (SMTP 4xx, or
# Microsoft's 550 5.7.708 "sending too much mail"), doubling for each of
# MAX_THROTTLE_RETRIES attempts before the run stops itself rather than
# risk escalating into a full account restriction. See README "Getting
# unblocked".
THROTTLE_BACKOFF_SECONDS=300
MAX_THROTTLE_RETRIES=2
# Max emails per run (safety cap; 0 = no limit)
MAX_PER_RUN=0

# Copy this file to .env and fill in your real values.
# NEVER commit your real .env file (it's already in .gitignore).

# --- SMTP connection ---
# Gmail / Google Workspace : smtp.gmail.com   port 587 (STARTTLS)
# Microsoft 365 / Outlook  : smtp.office365.com port 587 (STARTTLS)
# Other providers          : check your provider's SMTP docs
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false

# --- Your professional mailbox credentials ---
# Gmail/Workspace with 2FA enabled REQUIRES an App Password, not your
# normal login password: https://myaccount.google.com/apppasswords
SMTP_USER=you@yourcompany.com
SMTP_PASSWORD=your-app-password

# --- Sender identity shown to recipients ---
FROM_NAME=Your Name
FROM_EMAIL=you@yourcompany.com
REPLY_TO=you@yourcompany.com

# --- Sending behaviour ---
# Seconds to wait between messages (avoids provider rate limits / spam flags)
SEND_DELAY_SECONDS=2
# Max emails per run (safety cap; 0 = no limit)
MAX_PER_RUN=0
